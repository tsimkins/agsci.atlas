<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      lang="en"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="plone.app.dexterity">
<body>

<metal:block
fill-slot="top_slot"
   tal:define="dummy python:request.set('disable_border',1);
               disable_column_one python:request.set('disable_plone.leftcolumn',1);
               disable_column_two python:request.set('disable_plone.rightcolumn',1);" />
               
<metal:title fill-slot="content-description">
</metal:title>

<metal:main fill-slot="content-core">
    <metal:content-core define-macro="content-core">

        <h2>Generate Tracking URL and QR Code</h2>
        <p><a tal:attributes="href context/absolute_url">&larr; Back to <strong tal:content="context/Title" /></a></p>
        <div id="qr-generator"
            tal:condition="view/url|nothing"
            tal:attributes="data-fields view/fields|nothing;
                            data-user_id view/user_id|nothing;
                            data-user_name view/user_name|nothing;
                            data-url view/url|nothing;
                            data-dept_team view/dept_team|nothing;
                            data-sku view/sku|nothing;
                            data-utm_campaign view/utm_campaign|nothing;" />
                            
    <script type="text/javascript" src="https://tools.agsci.psu.edu/qr-generator/static/qr.js"></script>

    <script>
        $(document).ready( function() {
    
           $('#qr-generator').create_form();

        });
    </script>

    </metal:content-core>
</metal:main>

</body>
</html>
